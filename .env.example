# Local PostgreSQL settings for Docker Compose and the server.
POSTGRES_DB=schedule_assistant
POSTGRES_USER=schedule_app
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql://schedule_app:change-me-for-local-development@localhost:5432/schedule_assistant
PORT=3000

# Optional OpenAI-compatible model provider used only by the server.
# Do not put these values in client files or commit a real API key.
AI_PROVIDER_BASE_URL=https://api.example.com/v1
AI_PROVIDER_MODEL=example-model
AI_PROVIDER_API_KEY=replace-with-your-local-secret
